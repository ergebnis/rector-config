includes:
	- phpstan-baseline.neon

parameters:
	ergebnis:
		noExtends:
			classesAllowedToBeExtended:
				- Ergebnis\Rector\Config\Test\EndToEnd\RuleSet\AbstractRuleSetTestCase
				- Ergebnis\Rector\Config\Test\Unit\RuleSet\AbstractRuleSetTestCase
				- InvalidArgumentException

	inferPrivatePropertyTypeFromConstructor: true

	level: max

	paths:
		- src/
		- test/
		- .php-cs-fixer.php
		- rector.php

	tmpDir: .build/phpstan/

	treatPhpDocTypesAsCertain: false
