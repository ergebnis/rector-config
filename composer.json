{
  "name": "ergebnis/rector-config",
  "description": "Provides a configuration factory and rule sets for rector/rector.",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Andreas Möller",
      "email": "am@localheinz.com",
      "homepage": "https://localheinz.com"
    }
  ],
  "homepage": "https://github.com/ergebnis/rector-config",
  "support": {
    "issues": "https://github.com/ergebnis/rector-config/issues",
    "source": "https://github.com/ergebnis/rector-config",
    "security": "https://github.com/ergebnis/rector-config/blob/main/.github/SECURITY.md"
  },
  "require": {
    "php": "~7.4.0 || ~8.0.0 || ~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0 || ~8.7.0",
    "ergebnis/rector-rules": "~1.22.0",
    "rector/rector": "~2.9.2"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.58.0",
    "ergebnis/data-provider": "^3.8.0",
    "ergebnis/license": "^2.10.0",
    "ergebnis/php-cs-fixer-config": "^6.65.0",
    "ergebnis/phpstan-rules": "^2.18.0",
    "ergebnis/phpunit-slow-test-detector": "^2.28.0",
    "fakerphp/faker": "^1.24.1",
    "infection/infection": "~0.26.6",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.3.1",
    "phpstan/phpstan-deprecation-rules": "^2.0.6",
    "phpstan/phpstan-phpunit": "^2.1.3",
    "phpstan/phpstan-strict-rules": "^2.1.2",
    "phpunit/phpunit": "^9.6.38",
    "symfony/filesystem": "^5.4.54",
    "symfony/process": "^5.4.54"
  },
  "autoload": {
    "psr-4": {
      "Ergebnis\\Rector\\Config\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ergebnis\\Rector\\Config\\Test\\": "test/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "ergebnis/composer-normalize": true,
      "infection/extension-installer": true,
      "phpstan/extension-installer": true
    },
    "audit": {
      "abandoned": "report"
    },
    "platform": {
      "php": "7.4.33"
    },
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1-dev"
    },
    "composer-normalize": {
      "indent-size": 2,
      "indent-style": "space"
    }
  }
}
